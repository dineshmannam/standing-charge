# Copy to env.local.sh and fill in. Gitignored.

# One project per lever. Do not share.
export PROJECT_LEVER_A="sc-lever-a-idle"
export PROJECT_LEVER_B="sc-lever-b-context"
export PROJECT_LEVER_C="sc-lever-c-hosting"

export REGION="us-central1"
export VERTEX_MODEL="gemini-2.5-flash"
export OWNER="your-name"

# Where the billing exports live. Discover the FOCUS name with:
#   bq ls --project_id=YOUR_BILLING_PROJECT | grep billing_immutable
export BILLING_PROJECT="your-billing-project"
export DETAILED_DATASET="billing_export"
# export FOCUS_DATASET="gcp_billing_immutable_..."
